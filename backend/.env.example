DATABASE_URL=sqlite:///./b_gadget.db
PORT=8000
ENV=development
# SECRET_KEY dipakai auth.py untuk JWT - ganti di production
SECRET_KEY=change-me-please-use-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# --- AI Fase 0 (Ollama lokal, ganti vendor cukup via LLM_PROVIDER) ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT=qwen2.5:7b
OLLAMA_VISION=llama3.2-vision:11b
AI_TIMEOUT=10
AI_TIMEOUT_CHAT=60
# --- AI multi-model (gratisan dulu: ollama jalan, lainnya isi key belakangan) ---
LLM_PROVIDER=ollama
LLM_DEFAULT=ollama
# Space Bunny Alpha — free preview, ambil key di https://spacebunny.app lalu isi
SPACEBUNNY_BASE_URL=https://spacebunny.app/api/v1
SPACEBUNNY_MODEL=space-bunny
SPACEBUNNY_KEY=
# Muse Spark 1.2 — Meta Model API berbayar, key dari https://dev.meta.ai
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.2
META_API_KEY=
# Slot custom "yang lainnya" (Groq/OpenRouter/Gemini OpenAI-compat)
CUSTOM_LLM_LABEL=Custom
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_KEY=
